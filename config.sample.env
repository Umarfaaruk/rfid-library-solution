# Copy to .env or export before starting. No secrets are committed. Everything is optional.
RFIDLIB_DATA_DIR=./data
RFIDLIB_DB_FILE=library.db
# Leave unset to auto-generate data/jwt.key on first run. Set only from a secret store.
# RFIDLIB_JWT_SECRET=
RFIDLIB_LOAN_DAYS=14
RFIDLIB_MAX_RENEWALS=2
RFIDLIB_MAX_LOANS=5
RFIDLIB_FINE_PER_DAY=2.0
RFIDLIB_FINE_LIMIT=50.0
RFIDLIB_ISIL=IN-DEMO-001
RFIDLIB_SECURITY_EMAIL=security@library.example
